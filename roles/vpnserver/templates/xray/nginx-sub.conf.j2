# Static subscription endpoint (rendered by the vpnserver role).
# URL shape is panel-compatible: https://{{ domain_name }}:{{ vpnserver_sub_port }}/<sub_path>/<sub_id>
server {
    listen {{ vpnserver_sub_port }} ssl;
    server_name {{ domain_name }};

    ssl_certificate /certs/fullchain.pem;
    ssl_certificate_key /certs/privkey.pem;

    root /webroot;
    location / {
        try_files $uri =404;
    }

    add_header Profile-Title "{{ domain_name }}" always;
    add_header Profile-Update-Interval 12 always;
    add_header Cache-Control "no-store" always;
}
