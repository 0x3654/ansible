# Lampa web clone (static) — https://{{ lampaweb_domain_name }}
# Managed by Ansible

server {
    listen 80;
    server_name {{ lampaweb_domain_name }};
    return 301 https://$server_name$request_uri;
}

server {
    listen 443 ssl http2;
    server_name {{ lampaweb_domain_name }};

    ssl_certificate {{ lampaweb_cert_path }}/live/{{ lampaweb_domain_name }}/fullchain.pem;
    ssl_certificate_key {{ lampaweb_cert_path }}/live/{{ lampaweb_domain_name }}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;

    root {{ path }}/webroot;
    index index.html;

    # клон личный: в индекс не отдаём
    add_header X-Robots-Tag "noindex, nofollow" always;

    location = /robots.txt {
        default_type text/plain;
        return 200 "User-agent: *\nDisallow: /\n";
    }

    location / {
        try_files $uri $uri/ =404;
    }

    # статика кэшируется; заголовок повторён — location перекрывает server
    location ~* \.(js|css|png|jpg|jpeg|gif|svg|ico|woff|woff2|ttf|eot|ogg|mp4)$ {
        expires 7d;
        add_header Cache-Control "public";
        add_header X-Robots-Tag "noindex, nofollow" always;
        try_files $uri =404;
    }

    gzip on;
    gzip_comp_level 5;
    gzip_min_length 256;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml;
}
