/*
    lampainit.js — официальный хук загрузчика Lampa.

    В режиме «подмена адреса» оболочка сама грузит этот файл с нашего клона
    ДО app.min.js; при прямом открытии клона он подключён в index.html.
    Ждёт появления Lampa и подключает bootstrap t.js (ставит плагины
    и применяет настройки). Абсолютный адрес — файл исполняется и в чужой
    странице (оболочка), где относительный путь разрешился бы неверно.
*/
;(function(){
    'use strict'

    var FLAG = '__lampa_lampainit'

    if (window[FLAG]) return
    window[FLAG] = true

    // apple_tv без привязки к точным пикселям: детект лампы требует
    // РОВНО innerWidth==1920 && innerHeight==1080 — ломается на
    // оверсканах (safe-area ужимает до 1760×960), 4K, чужих оболочках.
    // TV-оболочка = ipad-UA без тача: ей отдаём метрики 1920×1080,
    // на которые рассчитан TV-дизайн лампы (WebKit сам масштабирует).
    // Настоящие iPad (с тачем) и десктоп-браузеры не трогаем
    ;(function(){
        var ua = (navigator.userAgent || '').toLowerCase()

        if (ua.indexOf('ipad') === -1 || 'ontouchstart' in window) return

        try{
            Object.defineProperty(window, 'innerWidth', {
                configurable: true,
                get: function(){ return 1920 }
            })

            Object.defineProperty(window, 'innerHeight', {
                configurable: true,
                get: function(){ return 1080 }
            })
        }catch(e){}
    })()

    // вырезать всё чужое, что не нужно для работы: рекламу cub (преролл
    // перед просмотром и баннеры), аналитику (/api/metric — uid, платформа,
    // premium, гео; каждый запуск плеера), гео-детект (geo.*) и метки
    // logged=/email= — ими бандл сообщает cub-серверам статус и email
    // юзера при каждом запросе. Мы грузимся ДО app.min.js — рвём запросы
    // до выхода в сеть; счётчики молча тихнут, реклама получает пустой
    // список и видео стартует сразу. Синхронизация аккаунта (api/account,
    // сокет) и прокси TMDB не трогаются
    ;(function(){
        var probe = document.createElement('a')

        function clean(url){
            probe.href = url

            // аналитика, гео, реклама, Shots, tsarea
            if(/\/api\/(ad\/get|metric)\//.test(probe.pathname)) return null
            if(CUB_JUNK.test(probe.pathname)) return null
            if(/^geo\./.test(probe.hostname)) return null

            // logged/email — только своему origin, чужим не сообщаем
            if(probe.hostname !== window.location.hostname && probe.search){
                var q = probe.search.slice(1).split('&').filter(function(p){
                    return p && p.indexOf('logged=') !== 0 && p.indexOf('email=') !== 0
                })

                probe.search = q.length ? '?' + q.join('&') : ''
            }

            return probe.href
        }

        // плагины cub, подтягиваемые бандлом с зеркал при каждом старте,
        // которых на клоне быть не должно: Shots (кадры в карточке/плеере),
        // tsarea (реклама аренды TorrServer с QR в настройках сервера) —
        // скрипты не грузятся вовсе, функционала и рекламы нет
        var CUB_JUNK = /\/plugin\/(shots|tsarea)\//

        function noJunk(url){
            return CUB_JUNK.test(url) ? 'about:blank' : url
        }

        var open = XMLHttpRequest.prototype.open
        var send = XMLHttpRequest.prototype.send

        XMLHttpRequest.prototype.open = function(){
            var url   = clean(String(arguments[1]))
            var args  = Array.prototype.slice.call(arguments)

            this.__drop = url === null

            if(!this.__drop && url !== args[1]) args[1] = url

            return open.apply(this, args)
        }

        XMLHttpRequest.prototype.send = function(){
            if(!this.__drop) return send.apply(this, arguments)

            var self = this

            setTimeout(function(){
                if(typeof self.onerror === 'function') self.onerror(new ProgressEvent('error'))
                else self.dispatchEvent(new ProgressEvent('error'))
            }, 0)
        }

        // метки едут не только в XHR: плагины грузятся <script src>,
        // постеры — <img src> через их зеркала; вырезаем logged/email из
        // src/href ЛЮБЫХ чужих доменов на уровне DOM (fetch при этом не
        // трогаем — загрузить надо, меняется только URL)
        function strip(url){
            try{
                probe.href = url
                if(probe.hostname === window.location.hostname || !probe.search) return url

                var q = probe.search.slice(1).split('&').filter(function(p){
                    return p && p.indexOf('logged=') !== 0 && p.indexOf('email=') !== 0
                })

                probe.search = q.length ? '?' + q.join('&') : ''
                return probe.href
            }
            catch(e){ return url }
        }

        [window.HTMLScriptElement, window.HTMLImageElement].forEach(function(proto){
            var d = Object.getOwnPropertyDescriptor(proto.prototype, 'src')
            if(!d || !d.set) return

            Object.defineProperty(proto.prototype, 'src', {
                get: d.get,
                set: function(v){ d.set.call(this, noJunk(strip(String(v)))) },
                configurable: true
            })
        })

        var setAttr = Element.prototype.setAttribute

        Element.prototype.setAttribute = function(name, value){
            if((name === 'src' || name === 'href') && typeof value === 'string')
                value = noJunk(strip(value))

            return setAttr.call(this, name, value)
        }
    })()

    // протокол страницы: клон открывают и по http (нативные приложения —
    // иначе UIWebView режет http://127.0.0.1:8090 как mixed content),
    // bootstrap грузим тем же протоколом, что и страница
    var BASE = window.location.protocol + '//' + '{{ lampaweb_domain_name }}'

    function boot(){
        if (!window.Lampa) return setTimeout(boot, 100)

        var s = document.createElement('script')

        // версия в URL меняется раз в час: фиксы bootstrap подхватываются
        // без жёсткого обновления страницы
        s.src = BASE + '/t.js?v=' + Math.floor(Date.now() / 36e5)
        s.onerror = function(){ /* клон недоступен — лампа работает без bootstrap */ }

        document.head.appendChild(s)
    }

    boot()
})()
