<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Деплой: роль backup (ansible). Запускает ~/.local/bin/backup-runner,
         контракты в ~/.backups/contracts/. Лог и run-report — в ~/backups/. -->
    <key>Label</key>
    <string>com.user.backup</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/python3</string>
        <string>{{ backup_runner_path }}</string>
    </array>
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>{{ backup_schedule_hour | default(0) }}</integer>
        <key>Minute</key>
        <integer>{{ backup_schedule_minute | default(30) }}</integer>
    </dict>
    <key>StandardOutPath</key>
    <string>{{ backup_backups_root }}/launchd.log</string>
    <key>StandardErrorPath</key>
    <string>{{ backup_backups_root }}/launchd.log</string>
</dict>
</plist>
