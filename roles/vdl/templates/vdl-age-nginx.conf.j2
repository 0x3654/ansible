# vdl cobalt-age (youtube age-gate) — Managed by Ansible
# tunnel-ссылки второго cobalt живут под ae2.0x3654.com (сертификат есть)
server {
    listen 443 ssl http2;
    server_name ae2.0x3654.com;

    ssl_certificate {{ vdl_cert_path }}/live/ae2.0x3654.com/fullchain.pem;
    ssl_certificate_key {{ vdl_cert_path }}/live/ae2.0x3654.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    location /tunnel/ {
        proxy_pass http://127.0.0.1:9002;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_buffering off;
        proxy_read_timeout 600s;
        proxy_send_timeout 600s;
    }

    location / {
        return 404;
    }
}
