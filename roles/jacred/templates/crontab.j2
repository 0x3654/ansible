# jacred parsers — managed by ansible (roles/jacred), do not edit
# rutracker/kinozal (FlareSolverr) парсятся на parser-ноде (мак), сюда не входят
SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

RUN=/server/jacred/data/run-job.sh
BASE=http://127.0.0.1:9117
DEV=?devkey={{ jacred_dev_key }}

# служебные
*/5 * * * *  root $RUN jsondb-save $BASE/jsondb/save 60
*/15 * * * *  root $RUN parseall-resume "$BASE/cron/maintenance/ResumeParseAll$DEV" 60
0 5 * * 0  root $RUN maintenance-check "$BASE/cron/maintenance/Check?mode=report&devkey={{ jacred_dev_key }}" 60

# rutor (~550k)
1,16,31,46 * * * *  root $RUN rutor-parse "$BASE/cron/rutor/parse$DEV" 900
5 2 * * *  root $RUN rutor-UpdateTasksParse "$BASE/cron/rutor/UpdateTasksParse$DEV" 60
30 5,17 * * *  root $RUN rutor-ParseAllTask "$BASE/cron/rutor/ParseAllTask$DEV" 60

# nnmclub (~145k)
5,20,35,50 * * * *  root $RUN nnmclub-parse "$BASE/cron/nnmclub/parse$DEV" 900
15 2 * * *  root $RUN nnmclub-UpdateTasksParse "$BASE/cron/nnmclub/UpdateTasksParse$DEV" 60
42 12 * * *  root $RUN nnmclub-ParseAllTask "$BASE/cron/nnmclub/ParseAllTask$DEV" 60

# megapeer (~113k)
8 * * * *  root $RUN megapeer-parse "$BASE/cron/megapeer/parse$DEV" 900
20 2 * * *  root $RUN megapeer-UpdateTasksParse "$BASE/cron/megapeer/UpdateTasksParse$DEV" 60
45 5,13,21 * * *  root $RUN megapeer-ParseAllTask "$BASE/cron/megapeer/ParseAllTask$DEV" 60

# аниме-маргина
6,21,36,51 * * * *  root $RUN aniliberty-parse "$BASE/cron/aniliberty/parse$DEV" 900
4,19,34,49 * * * *  root $RUN anidub-parse "$BASE/cron/anidub/parse$DEV" 900
29,59 * * * *  root $RUN anibelka-parse "$BASE/cron/anibelka/parse$DEV" 900
40 2 * * *  root $RUN anibelka-UpdateTasksParse "$BASE/cron/anibelka/UpdateTasksParse$DEV" 60
48 5,17 * * *  root $RUN anibelka-ParseAllTask "$BASE/cron/anibelka/ParseAllTask$DEV" 60
10 7 * * *  root $RUN anibelka-ParseLatest "$BASE/cron/anibelka/ParseLatest$DEV" 900
