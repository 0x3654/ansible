<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- jacred: обратный SSH-туннель моро -> ae2, parser API на localhost:9118 ae2.
     Managed by ansible (roles/jacred), не редактировать руками -->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.github.jacred.tunnel</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/ssh</string>
        <string>-N</string>
        <string>-R</string>
        <string>{{ jacred_tunnel_bind }}:{{ jacred_backend_port }}:127.0.0.1:{{ jacred_backend_port }}</string>
        <string>-o</string><string>ServerAliveInterval=30</string>
        <string>-o</string><string>ServerAliveCountMax=3</string>
        <string>-o</string><string>ExitOnForwardFailure=yes</string>
        <string>-o</string><string>StrictHostKeyChecking=accept-new</string>
        <string>-o</string><string>ConnectTimeout=15</string>
        <string>{{ jacred_tunnel_target }}</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>30</integer>
    <key>StandardOutPath</key>
    <string>{{ path }}/data/tunnel.log</string>
    <key>StandardErrorPath</key>
    <string>{{ path }}/data/tunnel.log</string>
</dict>
</plist>
