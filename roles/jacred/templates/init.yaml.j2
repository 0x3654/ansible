# jacred init.yaml — managed by ansible (roles/jacred)
listenip: any
listenport: {{ jacred_backend_port }}
apikey: "{{ jacred_api_key }}"
devkey: "{{ jacred_dev_key }}"

# rutracker/kinozal парсит parser-нода на маке (FlareSolverr живёт только
# там — на VPS chromium не стартует); мак держит обратный SSH-туннель и
# отдаёт свою базу на localhost:9118 этого хоста. Туннель упал — живём
# на своей базе. Остальное парсим сами кронами с этого хоста
syncapi: "http://127.0.0.1:9118"
synctrackers: [rutracker, kinozal]
opensync: false

mergeduplicates: true
mergenumduplicates: true
openstats: true
web: true

# chromium (FlareSolverr) на ae2 не стартует: 956MB RAM + swap, load под 30.
# rutracker/kinozal — с parser-ноды; cffetch+warp остаются на всякий
flaresolverr:
  enable: false
cffetch:
  enable: true
  url: http://host.docker.internal:8192/fetch
