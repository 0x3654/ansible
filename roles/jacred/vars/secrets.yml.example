---
# jacred secrets
# Copy this file to secrets.yml and fill in your values
# Generate: openssl rand -hex 16

# Ключ поиска — его получает Lampa (jackett_key в t.js)
jacred_api_key: "YOUR_API_KEY"

# Ключ админ-эндпоинтов (/dev/, /cron/, /jsondb) — только для ansible/cron
jacred_dev_key: "YOUR_DEV_KEY"
